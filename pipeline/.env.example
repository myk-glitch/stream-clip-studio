# Copy to .env (or run: python configure.py init) and replace only what you use.
# .env is ignored by git. Never commit it, paste it into an issue, or share it.
# Values starting with "your_" are treated as not set. Setup steps: ../docs/credentials.md
# You can store any of these in your OS keychain instead: python configure.py secret NAME

# --- Twitch: your own app from https://dev.twitch.tv/console/apps
# Needed for live alerts, top clips and VOD listing. Not needed to clip a live stream.
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret

# --- YouTube: your own Google Cloud project
# Full path to your OAuth client file (Desktop app). Leave as is to use the default location shown by `configure.py doctor`.
YOUTUBE_CLIENT_SECRET_FILE=your_path_to_client_secret.json
# Optional API key, used only to read view counts for the daily recap.
YOUTUBE_API_KEY=your_youtube_api_key

# --- Discord: optional webhooks (Channel settings > Integrations > Webhooks). Anyone with a URL can post to that channel.
DISCORD_WEBHOOK_ASK=your_discord_webhook_for_questions
DISCORD_WEBHOOK_TOPOST=your_discord_webhook_for_clips_to_post
DISCORD_WEBHOOK_POSTED=your_discord_webhook_for_posted_clips
DISCORD_WEBHOOK_LIVE=your_discord_webhook_for_live_alerts
DISCORD_WEBHOOK_RECAP=your_discord_webhook_for_the_daily_recap
